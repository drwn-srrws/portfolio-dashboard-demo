{
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "overrides": [
    {
      "files": "open-api/**/*.json",
      "options": {
        "printWidth": 20,
        "tabWidth": 2,
        "parser": "json"
      }
    }
  ]
}
